# ---------------------------------------------------------------------------
# Jivaayu Pet Care — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph
# tags, robots.txt and sitemap.xml — set this correctly before going live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public support number in E.164 without the "+", e.g. 919812345678.
# This is a business contact shown on the site, not customer data.
NEXT_PUBLIC_SUPPORT_WHATSAPP=911234567890

# Set to "false" once verified provider data replaces the mock listings.
# While anything other than "false", the UI shows a "sample listings" notice.
NEXT_PUBLIC_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Supabase — not required in this phase (the app runs on mock repositories).
# ---------------------------------------------------------------------------

# Project URL and PUBLISHABLE/anon key. These are safe to expose in the
# browser ONLY when Row Level Security is enabled on every table.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# WARNING: the service-role / secret key must NEVER appear in this file with a
# NEXT_PUBLIC_ prefix, and must never be imported into client code. If server-
# side privileged access is ever needed, add it as an unprefixed variable
# (SUPABASE_SERVICE_ROLE_KEY) and read it only inside a route handler or
# server action.
